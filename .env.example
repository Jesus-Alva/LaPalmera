# Variables usadas por docker-compose.yml (modo producción/autohospedado).
# Copia este archivo a ".env" y reemplaza los valores. En Railway, estas mismas
# variables se configuran en el dashboard de cada servicio, no en este archivo
# (Railway no lee docker-compose.yml).

# ---------- Base de datos ----------
POSTGRES_USER=lapalmera
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=lapalmera
# Dentro de la red de docker-compose el host es el nombre del servicio ("postgres").
# En Railway, usa la DATABASE_URL que provee el plugin de Postgres.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ---------- Backend (FastAPI) ----------
# Clave para firmar los JWT de sesión. Genera una única y secreta por entorno,
# por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente
# Dominios del frontend permitidos por CORS, separados por comas. Sin "https://"
# de más de un dominio real, el navegador bloqueará las peticiones del frontend.
ALLOWED_ORIGINS=https://tu-dominio-del-frontend.example.com

# ---------- Frontend (Next.js) ----------
# URL pública del backend, alcanzable desde el navegador del visitante.
NEXT_PUBLIC_API_URL=https://tu-dominio-del-backend.example.com/api/v1
# URL pública del sitio, usada para metadata/SEO (canonical, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://tu-dominio-del-frontend.example.com

# ---------- Celery/Redis/RabbitMQ (opcional, servicios comentados por defecto) ----------
# Solo necesarios si activas los servicios worker/flower/scheduler en docker-compose.yml.
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0
